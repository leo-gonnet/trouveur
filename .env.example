# Copy to `.env` next to compose.yaml on the host, chmod 600. Never commit the filled-in file.

# The image CI pushes, e.g. ghcr.io/<owner>/trouveur. TROUVEUR_TAG is rewritten to the deployed
# commit SHA on every deploy; set it back to an older SHA and `docker compose up -d` to roll back.
TROUVEUR_IMAGE=ghcr.io/OWNER/trouveur
# deploy.yml rewrites TROUVEUR_TAG to the pushed commit; the footer shows it, so a stale
# footer means a stale container.
TROUVEUR_TAG=latest

# POSTGRES_PASSWORD is consumed by the db container and must match the one in DATABASE_URL.
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql+asyncpg://trouveur:CHANGEME@db:5432/trouveur

# openssl rand -hex 32
SESSION_SECRET=CHANGEME

# Encrypts users' stored OpenRouter keys. Losing or changing it makes every stored key
# unrecoverable and each user must re-enter theirs. openssl rand -hex 32
ENCRYPTION_KEY=CHANGEME

# There is deliberately no installation-wide OPENROUTER_API_KEY. Reranking runs on each user's
# own key, entered in Settings, encrypted at rest and capped by a per-user monthly ceiling.

# "local-onnx" needs an image built with `uv sync --extra embeddings`.
# EMBEDDING_PROVIDER=local-onnx

# Sources to leave out of every sweep, comma separated. Retiring a source this way keeps its
# adapter -- months of knowledge about someone else's API -- so replugging it is one edit here.
# A tenant-scoped source can also be emptied of tenants; this is the only way to stop one that
# is not, such as arbeitsagentur.
# DISABLED_SOURCES=arbeitsagentur

# Arbeitsagentur only exposes a delta, so nothing it returns proves a posting is gone. Without an
# age cutoff its open set, and the ANN index with it, would grow without bound.
# STALE_CLOSE_DAYS=90

# Offsite copy of the corpus, nightly. The raw archive is the only input that cannot be
# recomputed and it lives on one disk. A private Hugging Face dataset repo, or `local:<path>` to
# rehearse. Scope the token to write on that ONE repo: it sits in a cron job on a public host.
# See docs/runbooks/corpus-export.md
# ARCHIVE_REPO=owner/trouveur-corpus
# ARCHIVE_TOKEN=CHANGEME

# Optional. Without SMTP the web UI still works; users simply get no digest, and a user with no
# email address never gets one either way.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_FROM=trouveur@example.com

# TROUVEUR_DOMAIN needs an A record pointing here before first start, or Caddy cannot get a cert.
TROUVEUR_DOMAIN=trouveur.example.com
TROUVEUR_ACME_EMAIL=you@example.com
